---
import type { CollectionEntry } from 'astro:content';
import { formatEventDate } from '../lib/content';

interface Props { event: CollectionEntry<'events'> }
const { event } = Astro.props;
const { title, image, summary, location } = event.data;
---

<article class="card">
  <a class="stretch" href={`/events/${event.id}/`}>
    {image && <img src={image} alt="" loading="lazy" />}
    <div class="card-body">
      <p class="eyebrow">{formatEventDate(event.data)}</p>
      <h3>{title}</h3>
      {location && <p class="meta">📍 {location}</p>}
      <p>{summary}</p>
    </div>
  </a>
</article>
