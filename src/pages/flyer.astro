---
// Printable flyer: open /flyer/ in a browser and print (or save as PDF).
// The QR code points at the donate page on whatever `site` is set to in astro.config.mjs.
import QRCode from 'qrcode';
import '../styles/global.css';

const donateUrl = new URL('/donate/', Astro.site).href;
const qr = await QRCode.toString(donateUrl, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#142a1d', light: '#ffffff' } });
const shortUrl = donateUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Flyer · Willing Spirit Animal Sanctuary</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      @page { size: letter; margin: 0.4in; }
      body { background: #ddd; }
      .page { background: var(--paper); width: 7.7in; min-height: 10.2in; margin: 1rem auto; padding: 0.45in; display: flex; flex-direction: column; align-items: center; text-align: center; border: 6px solid var(--forest); border-radius: 18px; }
      .logo { width: 3.3in; border-radius: 50%; }
      h1 { font-size: 2.6rem; margin: .3in 0 .1in; }
      .tagline { font-size: 1.25rem; color: var(--bark); margin: 0 0 .25in; }
      .qr-row { display: flex; align-items: center; gap: .35in; margin-top: auto; text-align: left; }
      .qr { width: 2.3in; height: 2.3in; flex: none; }
      .qr svg { width: 100%; height: 100%; }
      .qr-row h2 { font-size: 1.7rem; margin: 0 0 .08in; }
      .qr-row ul { margin: 0; padding-left: 1.1rem; font-size: 1.05rem; }
      .url { font-weight: 700; color: var(--forest); margin-top: .1in; overflow-wrap: anywhere; }
      .print-tip { text-align: center; font: 600 .95rem var(--sans); padding: .75rem; }
      @media print {
        body { background: none; }
        .page { margin: 0; width: auto; min-height: 9.9in; }
        .print-tip { display: none; }
      }
    </style>
  </head>
  <body>
    <p class="print-tip">Print this page (⌘P / Ctrl+P) or save as PDF. Scan the code with your phone to test it first!</p>
    <div class="page">
      <img class="logo" src="/images/logo.jpg" alt="Willing Spirit Animal Sanctuary" />
      <h1>Every animal deserves a second chance.</h1>
      <p class="tagline">Help us rescue, heal, and find loving homes for animals in need.</p>
      <div class="qr-row">
        <div class="qr" set:html={qr} />
        <div>
          <h2>Scan to help 🐾</h2>
          <ul>
            <li>Shop our Amazon wishlist</li>
            <li>Give any amount</li>
            <li>Meet our rescue pups</li>
          </ul>
          <p class="url">{shortUrl}</p>
        </div>
      </div>
    </div>
  </body>
</html>
