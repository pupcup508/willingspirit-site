---
import Base from '../layouts/Base.astro';
import settings from '../data/settings.json';
---

<Base title="Contact" description="Get in touch with Willing Spirit Animal Sanctuary.">
  <section class="section">
    <div class="narrow prose">
      <p class="eyebrow">Contact</p>
      <h1>We'd love to hear from you</h1>
      <p class="lead">Questions about our animals, donating items, volunteering, or partnering with us? Reach out anytime.</p>
      <dl class="facts">
        <dt>Email</dt><dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd>
        {settings.phone && <><dt>Phone</dt><dd>{settings.phone}</dd></>}
        <dt>Location</dt><dd>{settings.location}</dd>
        {settings.facebook && <><dt>Facebook</dt><dd><a href={settings.facebook}>Follow us</a></dd></>}
        {settings.instagram && <><dt>Instagram</dt><dd><a href={settings.instagram}>Follow us</a></dd></>}
      </dl>
    </div>
  </section>
</Base>
